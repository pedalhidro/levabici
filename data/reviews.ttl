## Valle Sul — WikiVoyage, atualizado 2023-07, soma 6.0/7
av:wikivoyage-valle-sul a lb:Review ;
    schema:itemReviewed emp:valle-sul ;
    schema:reviewRating av:wikivoyage-valle-sul_rating ;
    lb:trip av:wikivoyage-valle-sul_trip ;
    lb:disassemblyLevel lb:disassemblyFrontWheel ;
    lb:packingLevel lb:packingPartial ;
    lb:receiptRequirement lb:receiptNone ;
    lb:paymentLevel lb:paymentNone ;
    schema:reviewBody "Oficialmente: selim abaixado, rodas desmontadas e embalagem de plástico-bolha ou papelão. Na prática basta tirar a roda dianteira e passar um saco plástico; às vezes aceitam a bici montada. — WikiVoyage (atualizado 2023-07, soma 6.0/7)." ;
    prov:wasDerivedFrom <https://pt.wikivoyage.org/wiki/Bicicletas_como_Bagagem_em_%C3%94nibus_Rodovi%C3%A1rios_do_Brasil> ;
    prov:generatedAtTime "2026-08-14T12:00:00-03:00"^^xsd:dateTime .

