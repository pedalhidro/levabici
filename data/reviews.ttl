    lb:tripDate "2023-07-01"^^xsd:date .

## Graciosa — WikiVoyage, atualizado 2023-07, soma 5.5/7
av:wikivoyage-graciosa a lb:Review ;
    schema:itemReviewed emp:graciosa ;
    schema:reviewRating av:wikivoyage-graciosa_rating ;
    lb:trip av:wikivoyage-graciosa_trip ;
    lb:disassemblyLevel lb:disassemblyFull ;
    lb:packingLevel lb:packingPartial ;
    lb:receiptRequirement lb:receiptNone ;
    lb:paymentLevel lb:paymentNone ;
    schema:reviewBody "Bicicletas contam como 'encomenda' paga à parte, EXCETO se desmontadas e embaladas (tirar as duas rodas e passar um saco plástico), aí o transporte é grátis. Como encomenda, Curitiba–Morretes custava R$15 por bici em 2022. — WikiVoyage (atualizado 2023-07, soma 5.5/7)." ;
    prov:wasDerivedFrom <https://pt.wikivoyage.org/wiki/Bicicletas_como_Bagagem_em_%C3%94nibus_Rodovi%C3%A1rios_do_Brasil> ;
    prov:generatedAtTime "2026-08-14T12:00:00-03:00"^^xsd:dateTime .

