av:2026-08-16-pwbs8f a lb:Review ;
    prov:generatedAtTime "2026-08-16T02:33:52.824000+00:00"^^xsd:dateTime ;
    lb:disassemblyLevel lb:disassemblyFull ;
    lb:packingLevel lb:packingBoxed ;
    lb:paymentLevel lb:paymentFull ;
    lb:permissionNeeded true ;
    lb:receiptRequirement lb:receiptStated ;
    lb:stressLevel lb:stressHigh ;
    lb:trip av:2026-08-16-pwbs8f_trip ;
    schema:itemReviewed emp:azul ;
    schema:reviewBody "Azul pior empresa aérea do MUNDO. Não aceitam bicicletas nem mesmo em caixas (somente aquelas embalagens rígidas de plástico duro que custam o olho da cara que inviabilizam qualquer cicloturismo). Perdemos um voo de madrugada pois não aceitaram as bicicletas desmontadas na caixa, e tivemos a humilhação de ter que comprar correndo uma passagem de madrugada pela Gol. Jamais voarei com a Azul novamente. Fazem 5 anos esse ocorrido, já viajei 30x com Gol e LATAM e zero pela Azul." ;
    schema:reviewRating av:2026-08-16-pwbs8f_rating .

