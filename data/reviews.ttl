av:2026-08-16-7jqopm a lb:Review ;
    prov:generatedAtTime "2026-08-16T02:30:29.707000+00:00"^^xsd:dateTime ;
    lb:amountPaid av:2026-08-16-7jqopm_paid ;
    lb:disassemblyLevel lb:disassemblyFull ;
