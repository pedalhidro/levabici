    schema:itemReviewed emp:sptrans-aquatico-sp ;
    schema:reviewBody "Não dá para usar na prática. Limite de 1 ou 2 bicicletas sendo que o intervalo entre barcos é 30min e sempre haverá mais outras pessoas esperando. Os barcos possuem espaço para acomodar, mas não pode levar devido a regras estúpidas." ;
    schema:reviewRating av:2026-08-14-0ct87l_rating .

