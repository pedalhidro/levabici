@prefix lb:     <https://id.pedalhidrografi.co/levabici/terms#> .
@prefix emp:    <https://id.pedalhidrografi.co/levabici/empresa/> .
@prefix av:     <https://id.pedalhidrografi.co/levabici/avaliacao/> .
@prefix schema: <https://schema.org/> .
@prefix prov:   <http://www.w3.org/ns/prov#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .

#################################################################
# levabici — grafo de dados (semente)
#
# ATENÇÃO: as avaliações abaixo são EXEMPLOS ILUSTRATIVOS
# (lb:isExample true) para dar vida ao app antes dos relatos
# reais do coletivo. As empresas são reais; as experiências
# descritas NÃO são relatos verídicos — substitua-as conforme
# os relatos reais forem chegando.
#
# Convenção de IRIs (a mesma do amora): nós aninhados ganham IRIs
# determinísticos <pai>_rating / <pai>_trip / <pai>_trip_from /
# <pai>_trip_to — nunca blank nodes — para deleção/merge triviais.
#################################################################

#################################################################
# Empresas
#################################################################

emp:viacao-cometa a lb:Company ;
    schema:name "Viação Cometa" ;
    lb:mode lb:modeBus .

emp:auto-viacao-1001 a lb:Company ;
    schema:name "Auto Viação 1001" ;
    lb:mode lb:modeBus .

emp:expresso-guanabara a lb:Company ;
    schema:name "Expresso Guanabara" ;
    lb:mode lb:modeBus .

emp:viacao-garcia a lb:Company ;
    schema:name "Viação Garcia" ;
    lb:mode lb:modeBus .

emp:latam a lb:Company ;
    schema:name "LATAM Airlines Brasil" ;
    lb:mode lb:modePlane .

emp:azul a lb:Company ;
    schema:name "Azul Linhas Aéreas" ;
    lb:mode lb:modePlane .

emp:cptm a lb:Company ;
    schema:name "CPTM" ;
    lb:mode lb:modeTrain .

emp:ccr-barcas a lb:Company ;
    schema:name "CCR Barcas (Rio–Niterói)" ;
    lb:mode lb:modeFerry .

#################################################################
# Avaliações (exemplos ilustrativos)
#################################################################

## Viação Cometa — SP → Santos
av:cometa-2025-11-exemplo a lb:Review ;
    schema:itemReviewed emp:viacao-cometa ;
    schema:reviewRating av:cometa-2025-11-exemplo_rating ;
    lb:trip av:cometa-2025-11-exemplo_trip ;
    lb:stressLevel lb:stressSome ;
    lb:permissionNeeded true ;
    lb:disassemblyLevel lb:disassemblyNone ;
    lb:packingLevel lb:packingPartial ;
    lb:receiptRequirement lb:receiptNone ;
    lb:paymentLevel lb:paymentNone ;
    schema:reviewBody "Exemplo ilustrativo: bici inteira no bagageiro, embalada em plástico-bolha; foi só combinar com o motorista." ;
    lb:isExample true ;
    prov:generatedAtTime "2026-08-14T12:00:00-03:00"^^xsd:dateTime .

av:cometa-2025-11-exemplo_rating a schema:Rating ;
    schema:ratingValue 4 ;
    schema:bestRating 5 ;
    schema:worstRating 1 .

av:cometa-2025-11-exemplo_trip a schema:BusTrip ;
    lb:tripDate "2025-11-08"^^xsd:date ;
    lb:departurePlace av:cometa-2025-11-exemplo_trip_from ;
    lb:arrivalPlace av:cometa-2025-11-exemplo_trip_to .

av:cometa-2025-11-exemplo_trip_from a schema:Place ;
    schema:name "São Paulo (Terminal Tietê)" ;
    schema:latitude -23.516 ;
    schema:longitude -46.622 .

av:cometa-2025-11-exemplo_trip_to a schema:Place ;
    schema:name "Santos" ;
    schema:latitude -23.940 ;
    schema:longitude -46.335 .

