av:2026-08-15-v7e9nf a lb:Review ;
    prov:generatedAtTime "2026-08-15T18:53:27.528000+00:00"^^xsd:dateTime ;
    lb:disassemblyLevel lb:disassemblyNone ;
    lb:packingLevel lb:packingBoxed ;
    lb:paymentLevel lb:paymentNone ;
    lb:permissionNeeded true ;
    lb:receiptRequirement lb:receiptNone ;
    lb:stressLevel lb:stressHigh ;
    lb:trip av:2026-08-15-v7e9nf_trip ;
    schema:itemReviewed emp:unica-facil ;
    schema:reviewBody "Normas da empresa mudaram repentinamente sem qualquer aviso no ato da compra da passagem, nem pop up no site nem nada. Fui informado da nova regra apenas na plataforma de embarque. Um funcionário da rodoviária acabou arrumando uma caixa pra mim e consegui rapidamente embalar a bicicleta e parar o ônibus (que já estava dando ré, sem mim.) Cena totalmente dramática e desnecessária. A parte mais irônica é que argumentaram que o motivo da proibição seria que \"bicicletas poderiam danificar as bagagens de outros passageiros\", mas a minha bicicleta viajou sozinha dentro do bagageiro. Empresa ridícula." ;
    schema:reviewRating av:2026-08-15-v7e9nf_rating .

